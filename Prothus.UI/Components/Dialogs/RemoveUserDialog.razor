@inject IDialogService DialogService
@inject IUserManagementService UserManagementService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Are you sure you want to delete this user?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Delete</MudButton>
        <MudButton OnClick="Delete"></MudButton>
    </DialogActions>
</MudDialog>

@code {
    private UserManagementDto User = new();
    private string _message = string.Empty;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    public async Task Delete()
    {
        try
        {
            await UserManagementService.DeleteUserAsync(User.Id);
            _message = "User deleted successfuly";
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
        }
    }

    void Cancel() => MudDialog.Cancel();
}