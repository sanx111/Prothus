@page "/"

@using Blazored.SessionStorage
@using Prothus.Application.DTOs
@using Prothus.Application.Interfaces

@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject ISessionStorageService SessionStorage

<MudContainer Style="min-height:100vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
    <MudStack Style="align-items:center;" Row=true>
        <img src="images/gojo2.jpg" alt="login left" class=".login-image" margin-right:0px />
        <MudPaper Elevation=0 Style="padding:0; width:350px">
            <MudForm>
                <MudStack Style="align-items: center; padding: 24px">
                    <MudText Typo="Typo.h4">Login</MudText>
                    <MudTextField @bind-Value="_email" 
                                  Variant="Variant.Filled" 
                                  Label="E-mail" 
                                  Class="custom-textfield"
                    />
                    <MudTextField @bind-Value="_password" 
                                  Variant="Variant.Filled" 
                                  Label="Password" 
                                  Class="custom-textfield"
                                  InputType="InputType.Password"
                    />
                    <MudStack Row="true">
                        <MudButton  Style="width:300px" OnClick="HandleLogin" Variant="Variant.Filled" Color="Color.Success">Login</MudButton>
                        @*<MudButton OnClick="ToRegisterPage" Variant="Variant.Filled">Register</MudButton>*@
                    </MudStack>
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudText Color="Color.Error">@_errorMessage</MudText>
                    }
                </MudStack>
                   <MudDivider></MudDivider>
                   <MudText Align="Align.Center">or login with</MudText>
                <MudStack Style="align-items:center;justify-content:center; width:100%;" Row=true >
                    <MudButton 
                               Variant="Variant.Filled"
                               style="width:150px"
                               Color="Color.Secondary"
                               EndIcon="@Icons.Custom.Brands.Google">
                        Google
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               style="width:150px"
                               Color="Color.Primary"
                               EndIcon="@Icons.Custom.Brands.GitHub">
                        GitHub
                    </MudButton>
                   </MudStack>
            </MudForm>
        </MudPaper>
    </MudStack>    
</MudContainer>

<style>
    .login-image{
        width: fit-content;
        height: fit-content;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .custom-textfield{
        width: 300px ;
    }

</style>

@code {
    private MudForm _form = new();
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        try
        {
            var result = await AuthService.LoginAsync(new LoginRequestDto { Email = _email, Password = _password, });
            await SessionStorage.SetItemAsync("authToken", result.Token);
            Navigation.NavigateTo("/home");
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage = "Invalid email or password";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unexpected error: {ex.Message}";
        }
    }

    



private void ToRegisterPage()
    {
        Navigation.NavigateTo("/register");
    }

}