@page "/users"

@inject IUserQueryService UserQueryService

<MudContainer MaxWidth="MaxWidth.False">
    <MudDataGrid T="UserQueryDto" @ref="grid" Items="users" DragDropColumnReordering="_dragDropReorderingEnabled" ColumnsPanelReordering="_columnsPanelReorderingEnabled"
                 ColumnResizeMode="ResizeMode.Container" Hideable="_hideable" Filterable="_filterable" Groupable="_groupable" FilterMode="_filterMode" ShowMenuIcon="true">
        <Columns>
            <SelectColumn T="UserQueryDto" />
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <!-- Adicione outras colunas conforme a estrutura de UserDto -->
        </Columns>
        <PagerContent>
            <MudDataGridPager T="UserQueryDto" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    private DataGridFilterMode _filterMode = DataGridFilterMode.Simple;
    private bool _dragDropReorderingEnabled = true;
    private bool _columnsPanelReorderingEnabled = true;
    private bool _hideable = true;
    private bool _filterable = true;
    private bool _groupable = true;
    public MudDataGrid<UserQueryDto> grid = new();
    public IEnumerable<UserQueryDto> users = new List<UserQueryDto>();

    protected override async Task OnInitializedAsync()
    {
        users = await UserQueryService.GetUsersAsync();
    }

    private async Task HideColumnsAsync(bool hide)
    {
        foreach (var column in grid.RenderedColumns)
        {
            if (hide)
            {
                await column.HideAsync();
            }
            else
            {
                await column.ShowAsync();
            }
        }
    }
}
