@page "/users"

@inject IUserQueryService UserQueryService

<MudContainer MaxWidth="MaxWidth.False">
    <MudDataGrid T="UserQueryDto" 
                    Items="@_users" 
                    SortMode="SortMode.Multiple" 
                    Filterable="true" 
                    RowClick="@RowClicked" 
                    RowContextMenuClick="@RowRightClicked"
                    SelectedItemsChanged="@SelectedItemsChanged">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Users</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" 
                            Placeholder="Search" 
                            Adornment="Adornment.Start" 
                            Immediate="true" 
                            AdornmentIcon="@Icons.Material.Filled.Search" 
                            IconSize="Size.Medium" 
            />
        </ToolBarContent>
        <Columns>
            <SelectColumn T="UserQueryDto" />
            <PropertyColumn Property="x => x.Id" Title="Id" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <PropertyColumn Property="x => x.DateCreated" Title="Date Created" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="UserQueryDto" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    private IEnumerable<UserQueryDto> _users = new List<UserQueryDto>();
    private List<string> _events = new();
    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _users = await UserQueryService.GetUsersAsync();

    }

    void RowClicked(DataGridRowClickEventArgs<UserQueryDto> args)
    {
        _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void RowRightClicked(DataGridRowClickEventArgs<UserQueryDto> args)
    {
        _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void SelectedItemsChanged(HashSet<UserQueryDto> items)
    {
        _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
    }
}
