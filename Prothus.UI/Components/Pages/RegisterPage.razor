@rendermode InteractiveServer


@page "/register"
@using Prothus.Application.DTOs
@using Prothus.Application.Services
@using Prothus.Application.Interfaces

@inject NavigationManager NavigationManager
@inject IRegisterUserService IRegisterUserService

<MudContainer>
    <MudStack>
        <MudPaper>
            
            <MudForm Style="align-items:center;">
                <MudText Typo="Typo.h4">Register</MudText>
                <MudTextField @bind-Value="email" Label="E-mail" Variant="Variant.Outlined"></MudTextField>
                <MudTextField @bind-Value="password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"></MudTextField>
                <MudStack>
                    <MudButton OnClick="RegisterUser" Variant="Variant.Filled" Color="Color.Success">Register</MudButton>
                    <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Primary">Back</MudButton>
                </MudStack>
            </MudForm>
        </MudPaper>
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(message))
    {
    <MudAlert Severity="Severity.Info">@message</MudAlert>
    }   
</MudContainer>

@code {
    private MudForm form = new();
    private string email = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;

    public void Cancel()
    {
        NavigationManager.NavigateTo("/login");
    }

    public async Task RegisterUser()
    {
        try
        {
            var dto = new RegisterUserDto
            {
                Email = email,
                Password = password
            };

            await IRegisterUserService.RegisterUserAsync(dto);
            message = "Cadastro realizado com sucesso!";
            
            
        }
        catch (Exception ex)
        {
            message = $"Erro ao cadastrar: {ex.Message}";
        }
    }
}