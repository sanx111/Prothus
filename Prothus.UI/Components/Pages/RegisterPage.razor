

@page "/register"
@using Prothus.Application.DTOs
@using Prothus.Application.Services
@using Prothus.Application.Interfaces

@inject NavigationManager NavigationManager
@inject IUserManagementService IRegisterUserService

<MudContainer>
    <MudStack>
        <MudPaper>
            
            <MudForm Style="align-items:center;">
                <MudText Typo="Typo.h4">Register</MudText>
                <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined"></MudTextField>
                <MudTextField @bind-Value="_email" Label="E-mail" Variant="Variant.Outlined"></MudTextField>
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"></MudTextField>
                <MudStack>
                    <MudButton OnClick="RegisterUser" Variant="Variant.Filled" Color="Color.Success">Register</MudButton>
                    <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Primary">Back</MudButton>
                </MudStack>
            </MudForm>
        </MudPaper>
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
    <MudAlert Severity="Severity.Info">@_message</MudAlert>
    }   
</MudContainer>

@code {
    private MudForm form = new();
    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _message = string.Empty;

    public void Cancel()
    {
        NavigationManager.NavigateTo("/");
    }

    public async Task RegisterUser()
    {
        try
        {
            var dto = new UserManagementDto
            {
                Name = _name,
                Email = _email,
                Password = _password
            };

            await IRegisterUserService.RegisterUserAsync(dto);
            _message = "Cadastro realizado com sucesso!";
            
            
        }
        catch (Exception ex)
        {
            _message = $"Erro ao cadastrar: {ex.Message}";
        }
    }
}